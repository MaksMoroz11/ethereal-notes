POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=postgres
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
SSL_CERT_FILE=/etc/letsencrypt/live/example.com/fullchain.pem
SSL_KEY_FILE=/etc/letsencrypt/live/example.com/privkey.pem

# Учебная демонстрация: заполните перед публичным использованием
PRIVACY_OPERATOR=
PRIVACY_CONTACT=
COOKIE_SECURE=false
CONSENT_VERSION=2026-10-07
